# OrangeFox Recovery fstab for Realme 2 (RMX1805)
# Safe & Compatible Version

# Core Boot & System Partitions
/boot             emmc      /dev/block/bootdevice/by-name/boot               flags=backup=1;display="Boot"
/dtbo             emmc      /dev/block/bootdevice/by-name/dtbo               flags=backup=1;display="DTBO";flashimg=1
/recovery         emmc      /dev/block/bootdevice/by-name/recovery           flags=backup=1;display="Recovery"
/vbmeta           emmc      /dev/block/bootdevice/by-name/vbmeta             flags=backup=1;display="VBMeta";flashimg=1

# System & Vendor (mounted as ext4)
/system_root      ext4      /dev/block/bootdevice/by-name/system             flags=display="System"
/vendor           ext4      /dev/block/bootdevice/by-name/vendor             flags=display="Vendor";wipeingui

# System & Vendor (as raw images for backup/restore/flash)
/system_image     emmc      /dev/block/bootdevice/by-name/system             flags=backup=1;display="System Image"
/vendor_image     emmc      /dev/block/bootdevice/by-name/vendor             flags=backup=1;display="Vendor Image"

# Data Partition (CRITICAL FOR DECRYPTION)
/data             ext4      /dev/block/bootdevice/by-name/userdata             flags=noatime,nosuid,noatime,nodev,barrier=1,noauto_da_alloc,discard,lazytime       fsflags=wait,check,forceencrypt=footer,quota

# Other Partitions
/cache            ext4      /dev/block/bootdevice/by-name/cache              flags=display="Cache";formattable
/persist          ext4      /dev/block/bootdevice/by-name/persist            flags=display="Persist";backup=1
/firmware      vfat   /dev/block/bootdevice/by-name/modem                        flags=display="Firmware";mounttodecrypt
/dsp              emmc      /dev/block/bootdevice/by-name/dsp                flags=backup=1;display="DSP";flashimg=1
/efs1             emmc      /dev/block/bootdevice/by-name/modem_st1          flags=backup=1;display="EFS"
/efs2             emmc      /dev/block/bootdevice/by-name/modem_st2          flags=backup=1;display="EFS Backup"
/logo             emmc      /dev/block/bootdevice/by-name/LOGO               flags=flashimg=1;display="Logo"
/misc             emmc      /dev/block/bootdevice/by-name/misc               flags=display="Misc"
/oem              emmc      /dev/block/bootdevice/by-name/oem                flags=display="OEM"

# Removable Storage
/external_sd      vfat      /dev/block/mmcblk1p1            flags=display="MicroSD Card";storage;wipeingui;removable
/usbstorage		vfat	/dev/block/sdg1		/dev/block/sdg					flags=utf8                                                    fsflags=display="USB Storage";storage;wipeingui;removable

/keymaster      emmc      /dev/block/bootdevice/by-name/keymaster                flags=flashimg=1;display="Keymaster"
/keymasterbak      emmc      /dev/block/bootdevice/by-name/keymasterbak               flags=display="Keymaster Backup"
/keystore      emmc      /dev/block/bootdevice/by-name/keystore               flags=display="Keystore"
/dev/block/bootdevice/by-name/aboot        /aboot          emmc    flags=defaults
/dev/block/bootdevice/by-name/abootbak     /abootbak       emmc    flags=defaults
/dev/block/bootdevice/by-name/modem        /modem          emmc    flags=defaults
/dev/block/bootdevice/by-name/sbl1         /sbl1           emmc    flags=defaults
/dev/block/bootdevice/by-name/sbl1bak      /sbl1bak        emmc    flags=defaults
/dev/block/bootdevice/by-name/rpm          /rpm            emmc    flags=defaults
/dev/block/bootdevice/by-name/rpmbak       /rpmbak         emmc    flags=defaults
/dev/block/bootdevice/by-name/tz           /tz             emmc    flags=defaults
/dev/block/bootdevice/by-name/tzbak        /tzbak          emmc    flags=defaults
/dev/block/bootdevice/by-name/modem_st1    /modemst1       emmc    flags=defaults
/dev/block/bootdevice/by-name/modem_st2    /modemst2       emmc    flags=defaults
/dev/block/bootdevice/by-name/oppostanvbk  /static_nv_bk   emmc    flags=defaults
/dev/block/bootdevice/by-name/oppodycnvbk  /oppodycnvbk    emmc    flags=defaults
/dev/block/bootdevice/by-name/LOGO         /logo           emmc    flags=defaults
/dev/block/bootdevice/by-name/reserve4     /reserve4       emmc    flags=defaults
/dev/block/bootdevice/by-name/dsp          /dsp            emmc    flags=defaults
/dev/block/bootdevice/by-name/DDR          /DDR            emmc    flags=defaults
/dev/block/bootdevice/by-name/devcfg       /devcfg         emmc    flags=defaults
/dev/block/bootdevice/by-name/mdtp         /mdtp           emmc    flags=defaults
/dev/block/bootdevice/by-name/cmnlib       /cmnlib         emmc    flags=defaults
/dev/block/bootdevice/by-name/cmnlibbak    /cmnlibbak      emmc    flags=defaults
/dev/block/bootdevice/by-name/apdp         /apdp           emmc    flags=defaults
/dev/block/bootdevice/by-name/devinfo      /devinfo        emmc    flags=defaults
/dev/block/bootdevice/by-name/persist      /persist        ext4    flags=defaults
/dev/block/bootdevice/by-name/opporeserve2 /opporeserve    ext4    flags=wait,check
/dev/block/bootdevice/by-name/abl          /abl            emmc    flags=defaults
/dev/block/bootdevice/by-name/ablbak       /ablbak         emmc    flags=defaults
/dev/block/bootdevice/by-name/xbl          /xbl            emmc    flags=defaults
/dev/block/bootdevice/by-name/xblbak       /xblbak         emmc    flags=defaults