# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

# <mount_point>     <type>    <mnt_flags and options>                      <fs_mgr_flags>
/boot                emmc     /dev/block/bootdevice/by-name/boot           flags=display="Boot";backup=1;flashimg=1
/cache               ext4     /dev/block/bootdevice/by-name/cache          flags=display="Cache";backup=1;wipeingui;wipeduringfactoryreset
/system_root         ext4     /dev/block/bootdevice/by-name/system         flags=display="System";backup=0;wipeingui
/system_image        emmc     /dev/block/bootdevice/by-name/system         flags=display="System";flashimg=1;backup=1
/vendor              ext4     /dev/block/bootdevice/by-name/vendor         flags=display="Vendor";backup=0;wipeingui
/vendor_image        emmc     /dev/block/bootdevice/by-name/vendor         flags=display="Vendor";flashimg=1;backup=1
/data          ext4    /dev/block/bootdevice/by-name/userdata                     flags=forceencrypt=footer

/dtbo                emmc     /dev/block/bootdevice/by-name/dtbo           flags=display="DTBO";backup=1;flashimg=1
/recovery            emmc     /dev/block/bootdevice/by-name/recovery       flags=display="Recovery";backup=1;flashimg=1
/vbmeta              emmc     /dev/block/bootdevice/by-name/vbmeta         flags=display="VBMeta";backup=1;flashimg=1
/persist             ext4     /dev/block/bootdevice/by-name/persist        flags=display="Persist";backup=0
/persist_image       emmc     /dev/block/bootdevice/by-name/persist        flags=display="Persist";flashimg=1;backup=1

# Bootloader
/misc                emmc     /dev/block/bootdevice/by-name/misc           flags=display="Misc";backup=0
/aboot               emmc     /dev/block/bootdevice/by-name/aboot          flags=display="Bootloader";backup=0
/abootbak           emmc     /dev/block/bootdevice/by-name/abootbak       flags=display="Bootloaderbk";backup=0
/sbl1                emmc     /dev/block/bootdevice/by-name/sbl1           flags=display="SBL1";backup=0
/sbl1bak             emmc     /dev/block/bootdevice/by-name/sbl1bak        flags=display="SBL1bk";backup=0
/rpm                 emmc     /dev/block/bootdevice/by-name/rpm            flags=display="RPM";backup=0
/rpmbak             emmc     /dev/block/bootdevice/by-name/rpmbak         flags=display="RPMbk";backup=0
/tz                  emmc     /dev/block/bootdevice/by-name/tz             flags=display="TZ";backup=0
/tzbak               emmc     /dev/block/bootdevice/by-name/tzbak          flags=display="TZbk";backup=0
/ssd                 emmc     /dev/block/bootdevice/by-name/ssd            flags=display="SSD";backup=0
/static_nv_bk         emmc    /dev/block/bootdevice/by-name/oppostanvbk   flags=display="static_nv_bk";backup=0
/oppodycnvbk        emmc    /dev/block/bootdevice/by-name/oppodycnvbk   flags=display="oppodycnvbk";backup=0
/reserve4            emmc    /dev/block/bootdevice/by-name/reserve4        flags=display="reserve4";backup=0
/opporeserve         ext4      /dev/block/bootdevice/by-name/opporeserve2   flags=display="opporeserve";backup=0
/keystore            emmc     /dev/block/bootdevice/by-name/keystore       flags=display="Keystore";backup=0
/keymaster           emmc     /dev/block/bootdevice/by-name/keymaster      flags=display="Keymaster";backup=0
/DDR                 emmc     /dev/block/bootdevice/by-name/DDR            flags=display="DDR";backup=0
/devinfo             emmc     /dev/block/bootdevice/by-name/devinfo        flags=display="Dev Info";backup=0
/msadp               emmc     /dev/block/bootdevice/by-name/msadp          flags=display="MSADP";backup=0
/apdp                emmc     /dev/block/bootdevice/by-name/apdp           flags=display="APDP";backup=0
/cmnlib64            emmc     /dev/block/bootdevice/by-name/cmnlib64       flags=display="CMN Lib64";backup=0
/cmnlib              emmc     /dev/block/bootdevice/by-name/cmnlib         flags=display="CMN Lib";backup=0
/devcfg              emmc     /dev/block/bootdevice/by-name/devcfg         flags=display="Dev CFG";backup=0
/mdtp                emmc     /dev/block/bootdevice/by-name/mdtp           flags=display="MDTP";backup=0

# Firmware
/firmware            vfat     /dev/block/bootdevice/by-name/modem          flags=display="Firmware";backup=0;mounttodecrypt
/firmware_image      emmc     /dev/block/bootdevice/by-name/modem          flags=display="Firmware";backup=1
/dsp                 ext4     /dev/block/bootdevice/by-name/dsp            flags=display="DSP";backup=0
/dsp_image           emmc     /dev/block/bootdevice/by-name/dsp            flags=display="DSP";backup=1
/sec                 emmc     /dev/block/bootdevice/by-name/sec            flags=display="SEC";backup=1
/modem         emmc    /dev/block/bootdevice/by-name/modem                        flags=backup=1;display="Modem";fsflags=ro

# EFS
/efs1                emmc     /dev/block/bootdevice/by-name/modemst1       flags=display="EFS";backup=1
/efs2                emmc     /dev/block/bootdevice/by-name/modemst2       flags=display="EFS2";backup=1
/fsc                 emmc     /dev/block/bootdevice/by-name/fsc            flags=display="FSC";backup=1
/fsg                 emmc     /dev/block/bootdevice/by-name/fsg            flags=display="FSG";backup=1

# Removable storage
/external_sd         auto     /dev/block/mmcblk1p1  /dev/block/mmcblk1     flags=display="MicroSD Card";storage;wipeingui;removable;fsflags="utf8"
/usb-otg             auto     /dev/block/sdg1       /dev/block/sdg         flags=display="USB OTG";storage;wipeingui;removable;fsflags="utf8"
